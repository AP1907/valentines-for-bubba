<!DOCTYPE html>
<html>
<head>
    <title>For My Valentine ❤️</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="card">
        <h1>Happy Valentine’s Day 💕</h1>
        <p>Dear Baba,</p>
        <p>
            You make my world brighter every day.  
            I’m grateful for you, for us, and for every smile you give me.
        </p>
        <button onclick="showMessage()">Click Me 💌</button>
        <p id="secret"></p>
    </div>

<script>
function showMessage() {
    document.getElementById("secret").innerText =
    "I love you forever ❤️ – Anshuman";
}
</script>
</body>
</html>
